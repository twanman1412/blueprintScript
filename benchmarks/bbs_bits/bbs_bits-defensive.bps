function i32 mulMod(i32 a, i32 b, i32 mod) {
	assert(b >= 0);
	assert(mod > 1);

    i32 result = 0;
    a = a % mod;
	assert(a >= 0);

    while (b > 0) {
        if (b % 2 == 1) {
            result = (result + a) % mod;
			assert(result >= 0);
        }
        a = (a + a) % mod;
		assert(a >= 0);
        b = b / 2;
    }

    return result;
}

function i32 bbsBits(i32 seed, i32 modulus, i32 count) {
	assert(count >= 0);
	assert(modulus > 1);

    i32 result = 0;
    i32 sumMod = 1000000007;
    i32 i = 0;

    seed = seed % modulus;
    if (seed < 0) {
        seed = seed + modulus;
    }

    while (i < count) {
        seed = mulMod(seed, seed, modulus);
        result = (result + (seed % 2)) % sumMod;
		assert(result >= 0);
        i = i + 1;
    }

    return result;
}

function i32 bbsStress() {
    i32 seed = 123456789;
    i32 modulus = 1000003;
    i32 count = 200000000;

    return bbsBits(seed, modulus, count);
}

print(bbsStress());
