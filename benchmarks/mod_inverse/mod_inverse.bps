blueprint mulMod {
    input: a: i32, b: i32, mod: i32;
    output: i32;
    default: a == 0 ==> 0;
    default: b == 0 ==> 0;
    requires: b >= 0 && mod > 1;
    ensures: mulMod >= 0 && mulMod < mod;
}

blueprint modExp {
    input: base: i32, exp: i32, mod: i32;
    output: i32;
    default: exp == 0 ==> 1;
    requires: exp >= 0 && mod > 1;
    ensures: modExp >= 0 && modExp < mod;
}

blueprint modInverse {
    input: a: i32, mod: i32;
    output: i32;
    default: a % mod == 0 ==> 0;
    requires: mod > 1;
    ensures: modInverse >= 0 && modInverse < mod;
}

function i32 mulMod(i32 a, i32 b, i32 mod) {
    i32 result = 0;
    a = a % mod;
    if (a < 0) {
        a = a + mod;
    }

    while (b > 0) {
        if (b % 2 == 1) {
            result = (result + a) % mod;
        }
        a = (a + a) % mod;
        b = b / 2;
    }

    return result;
}

function i32 modExp(i32 base, i32 exp, i32 mod) {
    i32 result = 1;
    base = base % mod;
    if (base < 0) {
        base = base + mod;
    }

    while (exp > 0) {
        if (exp % 2 == 1) {
            result = mulMod(result, base, mod);
        }
        exp = exp / 2;
        base = mulMod(base, base, mod);
    }

    return result;
}

function i32 modInverse(i32 a, i32 mod) {
    return modExp(a, mod - 2, mod);
}

function i32 modInverseStress() {
    i32 result = 0;
    i32 modulus = 1000000007;
    i32 iterations = 2000000;
    i32 i = 1;

    while (i <= iterations) {
        i32 inv = modInverse(i, modulus);
        result = (result + inv) % modulus;
        i = i + 1;
    }

    return result;
}

print(modInverseStress());
