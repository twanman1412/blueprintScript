function bool isSquare(i32 n) {
	assert(n >= 0);

    i32 odd = 1;
    while (n > 0) {
        n = n - odd;
        odd = odd + 2;
    }

    return n == 0;
}

function i32 squareStress() {
    i32 count = 0;
    i32 i = 0;
    i32 limit = 10000000;

    while (i <= limit) {
        if (isSquare(i)) {
            count = count + 1;
        }
        i = i + 1;
    }

    return count;
}

print(squareStress());
