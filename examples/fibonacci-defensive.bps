function i32 fibonacci(i32 n) {
    if (n < 0) {
        exit(-1);
    }

    if (n <= 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }

	i32 res = fibonacci(n - 1) + fibonacci(n - 2);
	if (res < 0) {
		exit(-1);
	}
	return res;
}

function i32 fibonacciStress() {
	i32 result = 0;
	i32 iterations = 45;
	i32 i = 0;

	while (i <= iterations) {
		result = result + fibonacci(i);
		i = i + 1;
	}

	return result;
}

print(fibonacciStress());

