blueprint intSqrt {
    input: n: i32;
    output: i32;
    default: n == 0 ==> 0;
    requires: n >= 0;
    ensures: intSqrt >= 0 && intSqrt <= n;
}

function i32 intSqrt(i32 n) {
    i32 low = 0;
    i32 high = n;
    i32 result = 0;

    while (low <= high) {
        i32 mid = low + (high - low) / 2;
        if (mid == 0) {
            result = 0;
            low = 1;
        } else if (mid <= n / mid) {
            result = mid;
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    return result;
}

print(intSqrt(70));
