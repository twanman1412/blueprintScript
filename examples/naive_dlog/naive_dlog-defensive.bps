function i32 mulMod(i32 a, i32 b, i32 mod) {
	assert(b >= 0);
	assert(mod > 1);

    i32 result = 0;
    a = a % mod;
    if (a < 0) {
        a = a + mod;
    }

    while (b > 0) {
        if (b % 2 == 1) {
            result = (result + a) % mod;
			assert(result >= 0);
        }
        a = (a + a) % mod;
		assert(a >= 0);
        b = b / 2;
    }

    return result;
}

function i32 modExp(i32 base, i32 exp, i32 mod) {
	assert(exp >= 0);
	assert(mod > 1);

    i32 result = 1;
    base = base % mod;
    if (base < 0) {
        base = base + mod;
    }

    while (exp > 0) {
        if (exp % 2 == 1) {
            result = mulMod(result, base, mod);
			assert(result >= 0);
        }
        exp = exp / 2;
        base = mulMod(base, base, mod);
		assert(base >= 0);
    }

	assert(result >= 0);
	assert(result < mod);
    return result;
}

function i32 discreteLog(i32 base, i32 target, i32 mod) {
	assert(mod > 1);
	assert(base >= 0);
	assert(target >= 0);

    i32 value = 1;
    i32 x = 0;

    while (x < mod) {
        if (value == target) {
            return x;
        }
        value = mulMod(value, base, mod);
        x = x + 1;
    }

    return -1;
}

print(discreteLog(2, 16, 17));
